{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swarm Simulator",
  "mainBinaryName": "swarm-desktop",
  "version": "0.1.0",
  "identifier": "com.swarmsim.desktop",
  "build": {
    "frontendDist": "../../../app/dist",
    "beforeBuildCommand": {
      "script": "SWARM_WASM_REQUIRED=1 pnpm --filter \"@swarmsim/app...\" build",
      "cwd": "../../.."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Swarm Simulator",
        "width": 480,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Game",
    "shortDescription": "Swarm Simulator: grow a swarm of bugs",
    "longDescription": "Swarm Simulator, the incremental game, on the desktop. Saves live in the app data directory.",
    "license": "GPL-3.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "games"
      }
    }
  }
}
